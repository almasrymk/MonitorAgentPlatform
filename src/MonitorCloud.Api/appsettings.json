{
  "ConnectionStrings": {
    "Monitor": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Jwt": {
    "Issuer": "monitor-cloud",
    "Audience": "monitor-cloud-portal",
    "DeviceAudience": "monitor-agent-gateway",
    "SigningKey": "",
    "DeviceSigningKey": ""
  },
  "Cors": {
    "Origins": []
  },
  "Seed": {
    "ApplyMigrations": false,
    "DemoData": false
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "BatchSize": 50
  },
  "AllowedHosts": "*"
}
