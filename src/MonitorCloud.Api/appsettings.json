{
  "ConnectionStrings": {
    "Monitor": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Jwt": {
    "Issuer": "monitor-cloud",
    "Audience": "monitor-cloud-portal",
    "DeviceAudience": "monitor-agent-gateway",
    "SigningKey": "",
    "DeviceSigningKey": ""
  },
  "Cors": {
    "Origins": []
  },
  "Seed": {
    "ApplyMigrations": false,
    "DemoData": false
  },
  "Licensing": {
    "Mode": "Fake",
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "ProductCode": "000001",
    "SyncIntervalSeconds": 60,
    "FullReconcileHours": 24,
    "EntitlementStaleAfterMinutes": 30,
    "UnlicensedGraceDays": 14,
    "FailOpenHours": 72,
    "ExpiringSoonDays": 30,
    "SyncEnabled": true,
    "FakeDataPath": "",
    "PortalUrl": ""
  },
  "Agent": {
    "GatewayUrl": "http://localhost:5300",
    "PublicBaseUrl": "http://localhost:5300",
    "SupportedProtocolMin": 1,
    "SupportedProtocolMax": 1,
    "EnrollPerFingerprintPerHour": 5,
    "BackgroundJobsEnabled": true
  },
  "Gateway": {
    "HelloTimeoutSeconds": 10,
    "HeartbeatSeconds": 30,
    "OfflineGraceSeconds": 15,
    "PresenceIntervalSeconds": 10,
    "SessionLifetimeHours": 12,
    "MaxBatchMinutes": 60,
    "PresenceEnabled": true
  },
  "Outbox": {
    "PollInterval": "00:00:02",
    "BatchSize": 50
  },
  "AllowedHosts": "*"
}
