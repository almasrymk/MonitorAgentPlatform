{
  "name": "portal",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint && node scripts/check-logical-css.mjs",
    "e2e": "playwright test",
    "api:types": "openapi-typescript http://localhost:5300/openapi/v1.json -o src/app/core/api/schema.d.ts",
    "build:check": "node scripts/check-bundle-size.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.11",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.1",
    "@vitest/coverage-v8": "4.1.11",
    "@playwright/test": "1.63.0",
    "openapi-typescript": "7.13.0"
  }
}
